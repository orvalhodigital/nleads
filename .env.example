# Variáveis com prefixo VITE_ são embutidas no bundle e ficam PÚBLICAS.
# Qualquer segredo real precisa ficar sem esse prefixo e ser usado apenas em api/.

# --- Supabase ---
VITE_SUPABASE_URL=seu_supabase_url
VITE_SUPABASE_ANON_KEY=seu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_supabase_service_role_key

# --- Cobrança (Asaas) ---
ASAAS_API_KEY=sua_asaas_api_key
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=seu_asaas_webhook_token

# --- IA (OpenAI com fallback OpenRouter) ---
OPENAI_API_KEY=sua_openai_api_key
OPENROUTER_API_KEY=sua_openrouter_api_key

# --- Domínio customizado do lojista (api/register-custom-domain, remove-custom-domain) ---
# Sem estas duas, o cadastro de domínio próprio falha.
VERCEL_API_TOKEN=seu_vercel_api_token
VERCEL_PROJECT_ID=seu_vercel_project_id

# --- Outros ---
APIPLACAS_TOKEN=seu_api_placas_token
WEBHOOK_SECRET=seu_webhook_secret_de_leads
