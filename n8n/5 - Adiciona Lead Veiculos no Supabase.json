    {
      "parameters": {
        "jsCode": "// Acessamos os dados que estão vindo diretamente no nó anterior\nconst input = $input.item.json;\n\n// Pegamos o número que está no campo 'numero_do_lead'\nconst remoteJid = input.numero_do_lead;\n\nif (!remoteJid) {\n  return {\n    erro: \"Campo 'numero_do_lead' não encontrado na entrada.\",\n    recebido: input\n  };\n}\n\n// 1. Remove o sufixo @s.whatsapp.net\nlet phone = remoteJid.split('@')[0];\n\n// 2. Remove o DDI 55 (Brasil) se presente\nif (phone.startsWith('55')) {\n  phone = phone.substring(2);\n}\n\n// 3. Aplica a formatação (XX) XXXXX-XXXX\nlet formatted;\nif (phone.length === 11) {\n    formatted = phone.replace(/^(\\d{2})(\\d{5})(\\d{4})$/, \"($1) $2-$3\");\n} else if (phone.length === 10) {\n    formatted = phone.replace(/^(\\d{2})(\\d{4})(\\d{4})$/, \"($1) $2-$3\");\n} else {\n    formatted = phone;\n}\n\nreturn {\n  numero_formatado: formatted,\n  numero_limpo: phone,\n  nome_lead: input.nome_do_lead || \"Lead sem nome\",\n  email_revenda: input.email_da_revenda,\n  numero_revenda: input.numero_da_revenda\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        176
      ],
