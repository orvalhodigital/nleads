import React, { createContext, useContext, useState, useEffect, useCallback, useRef } from 'react';
import { leadService } from '../services/leadService';
import { Lead } from '../types';
import { useAuth } from './AuthContext';
import { useToast } from './ToastContext';
import { supabase } from '../lib/supabaseClient';

interface LeadContextType {
    leads: Lead[];
    loadingLeads: boolean;
    hasMoreLeads: boolean;
    refreshLeads: () => Promise<void>;
    loadMoreLeads: () => Promise<void>;
    addLead: (lead: Omit<Lead, 'id' | 'createdAt' | 'lastUpdate'>) => Promise<Lead>;
    updateLead: (lead: Lead) => Promise<Lead>;
    deleteLead: (id: string) => Promise<void>;
}

const LeadContext = createContext<LeadContextType>({} as LeadContextType);

export const useLeads = () => useContext(LeadContext);

export const LeadProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
    const [leads, setLeads] = useState<Lead[]>([]);
    const [loadingLeads, setLoadingLeads] = useState(false);
    const [hasMoreLeads, setHasMoreLeads] = useState(true);
    const [page, setPage] = useState(0);
    const PAGE_SIZE = 50;

    const { session, impersonatedUserId } = useAuth();
    const { showToast } = useToast();

    const fetchLeads = useCallback(async (pageNum: number, append: boolean = false) => {
        if (!session) return;
        setLoadingLeads(true);
        try {
            const data = await leadService.list(impersonatedUserId, PAGE_SIZE, pageNum * PAGE_SIZE);
            if (append) {
                setLeads(prev => [...prev, ...data]);
            } else {
                setLeads(data);
            }
            setHasMoreLeads(data.length === PAGE_SIZE);
        } catch (err: any) {
            console.error('Error loading leads:', err);
            showToast('error', 'Erro ao carregar leads.');
        } finally {
            setLoadingLeads(false);
        }
    }, [session, impersonatedUserId, showToast]);

    const refreshLeads = useCallback(async () => {
        setPage(0);
        await fetchLeads(0, false);
    }, [fetchLeads]);

    const loadMoreLeads = useCallback(async () => {
        if (loadingLeads || !hasMoreLeads) return;
        const nextPage = page + 1;
        setPage(nextPage);
        await fetchLeads(nextPage, true);
    }, [page, loadingLeads, hasMoreLeads, fetchLeads]);

    const fetchLeadsRef = useRef(fetchLeads);
    useEffect(() => {
        fetchLeadsRef.current = fetchLeads;
    }, [fetchLeads]);

    useEffect(() => {
        if (session) {
            fetchLeadsRef.current(0, false);
            
            // Trigger automated notifications via RPC
            supabase.rpc('check_and_send_automated_notifications', { target_user_id: session.user.id })
                .catch(err => console.error('Automated Notifications Trigger Error:', err));
        } else {
            setLeads([]);
        }
    }, [session]); // Only run when session changes

    const addLead = async (lead: Omit<Lead, 'id' | 'createdAt' | 'lastUpdate'>) => {
        const newLead = await leadService.create(lead);
        setLeads(prev => [newLead, ...prev]);
        return newLead;
    };

    const updateLead = async (lead: Lead) => {
        const updated = await leadService.update(lead);
        setLeads(prev => prev.map(l => l.id === updated.id ? updated : l));
        return updated;
    };

    const deleteLead = async (id: string) => {
        await leadService.delete(id);
        setLeads(prev => prev.filter(l => l.id !== id));
    };

    return (
        <LeadContext.Provider value={{ 
            leads, 
            loadingLeads, 
            hasMoreLeads,
            refreshLeads, 
            loadMoreLeads,
            addLead, 
            updateLead, 
            deleteLead 
        }}>
            {children}
        </LeadContext.Provider>
    );
};
